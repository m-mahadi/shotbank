{
  "name": "shotbank",
  "version": "0.1.0",
  "description": "A local-first desktop app for capturing and annotating cinematic reference frames.",
  "license": "MIT",
  "author": "Moniruzzaman Mahadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-mahadi/shotbank.git"
  },
  "bugs": {
    "url": "https://github.com/m-mahadi/shotbank/issues"
  },
  "homepage": "https://github.com/m-mahadi/shotbank#readme",
  "keywords": [
    "electron",
    "nextjs",
    "screenshots",
    "cinematography",
    "reference",
    "local-first"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "npm run build && node scripts/prepare-electron.js && electron .",
    "electron:dist": "npm run build && node scripts/prepare-electron.js && electron-builder --win"
  },
  "build": {
    "appId": "com.monir.shotbank",
    "productName": "ShotBank",
    "icon": "build/icon.ico",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      ".next/standalone/**/*",
      ".next/standalone/.next/static/**/*",
      ".next/standalone/public/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.1",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
